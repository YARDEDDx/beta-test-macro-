-- Automated Inventory Slotter Function
local function sortInventorySlots()
    pcall(function()
        local backpack = p:FindFirstChild("Backpack")
        local character = p.Character
        if not backpack or not character then return end

        -- Desired Loadout Mapping Rules
        local targetSlots = {
            [4] = {"Stop Sign", "Weapon"}, -- Fallback slot 4 weapon
            [5] = {"RPG"},
            [6] = {"Love Board"},
            [7] = {"Golden Snow"},
            [8] = {"Brass Knuckles", "Fists"},
            [9] = {"Normal Snow", "Parasol"},
            [0] = {"Parasol"}
        }

        -- Function to move tool to backpack/character slot simulation via tool parent swapping
        local function equipToSlot(toolName, targetSlotIndex)
            local item = backpack:FindFirstChild(toolName) or character:FindFirstChild(toolName)
            if item then
                -- Standard Roblox backpack slot assignment via Parent handling or StarterGui
                item.Parent = character
                task.wait(0.05)
            end
        end

        for slotNum, itemNames in pairs(targetSlots) do
            for _, name in ipairs(itemNames) do
                equipToSlot(name, slotNum)
            end
        end
    end)
end

-- Assist Engine Loop
RunService.RenderStepped:Connect(function(dt)
    if not AssistSettings.Enabled then
        currentBestTarget = nil
        return
    end

    local closestTarget = nil
    local shortestDist = AssistSettings.Effectiveness
    local viewportCenter = Camera.ViewportSize / 2
    local char = p.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= p and (AssistSettings.TargetPlayer == "Auto (Closest)" or plr.Name == AssistSettings.TargetPlayer) then
            if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local targetRoot = plr.Character.HumanoidRootPart
                    
                    local hasLOS = true
                    if AssistSettings.WallCheck and root then
                        local raycastParams = RaycastParams.new()
                        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                        raycastParams.FilterDescendantsInstances = {char, plr.Character}
                        local rayResult = workspace:Raycast(root.Position, targetRoot.Position - root.Position, raycastParams)
                        if rayResult then hasLOS = false end
                    end

                    if hasLOS then
                        local velocity = targetRoot.AssemblyLinearVelocity
                        local predictedPos = targetRoot.Position + (velocity * 0.12)
                        local screenPos, onScreen = Camera:WorldToViewportPoint(predictedPos)
                        
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                closestTarget = Vector2.new(screenPos.X, screenPos.Y)
                            end
                        end
                    end
                end
            end
        end
    end

    if closestTarget then
        if currentBestTarget then
            currentBestTarget = currentBestTarget:Lerp(closestTarget, AssistSettings.Smoothing)
        else
            currentBestTarget = closestTarget
        end
    else
        currentBestTarget = nil
    end
end)

local function clickCursor(b)
    pcall(function()
        local loc = UIS:GetMouseLocation()
        local btn = b or 0
        VIM:SendMouseButtonEvent(loc.X, loc.Y, btn, true, game, 0)
        task.wait(0.015)
        VIM:SendMouseButtonEvent(loc.X, loc.Y, btn, false, game, 0)
    end)
end

local function clickAtTarget(b)
    pcall(function()
        local mouseLoc = UIS:GetMouseLocation()
        local targetX = (AssistSettings.Enabled and currentBestTarget) and currentBestTarget.X or mouseLoc.X
        local targetY = (AssistSettings.Enabled and currentBestTarget) and currentBestTarget.Y or mouseLoc.Y
        local btn = b or 0

        VIM:SendMouseButtonEvent(targetX, targetY, btn, true, game, 0)
        task.wait(0.015)
        VIM:SendMouseButtonEvent(targetX, targetY, btn, false, game, 0)
    end)
end

local function pressKey(k)
    pcall(function()
        VIM:SendKeyEvent(true, k, false, game)
        task.wait(0.01)
        VIM:SendKeyEvent(false, k, false, game)
    end)
end

