local function clickCursor(b)
    pcall(function()
        local loc = UIS:GetMouseLocation()
        local btn = b or 0
        VIM:SendMouseButtonEvent(loc.X, loc.Y, btn, true, game, 0)
        task.wait(0.015)
        VIM:SendMouseButtonEvent(loc.X, loc.Y, btn, false, game, 0)
    end)
end

local function pressKey(k)
    pcall(function()
        VIM:SendKeyEvent(true, k, false, game)
        task.wait(0.01)
        VIM:SendKeyEvent(false, k, false, game)
    end)
end

-- Automatic Aiming Helper: Finds the closest player and moves camera/cursor to target them
local function aimAtClosestPlayer()
    pcall(function()
        local closestTarget = nil
        local shortestDistance = math.huge
        local mouseLoc = UIS:GetMouseLocation()

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= p and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local rootPart = plr.Character.HumanoidRootPart
                    local screenPos, onScreen = Camera:WorldToScreenPoint(rootPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mouseLoc).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            closestTarget = screenPos
                        end
                    end
                end
            end
        end

        -- If a valid target is found on screen, snap or shift mouse/aim towards them
        if closestTarget then
            VIM:SendMouseMoveEvent(closestTarget.X, closestTarget.Y, game)
        end
    end)
end

-- Exact XML Verified Snowball Macro with Integrated Auto-Aim
local function runSnowball()
    if isRunning then return end
    isRunning = true
    
    -- Automatically lock onto the nearest player before throwing snowballs
    aimAtClosestPlayer()
    task.wait(0.02)

    pressKey(Enum.KeyCode.Seven)
    clickCursor(0)
    task.wait(0.02)
    
    aimAtClosestPlayer()
    pressKey(Enum.KeyCode.Nine)
    clickCursor(0)
    task.wait(0.02)
    
    pressKey(Enum.KeyCode.Six)
    clickCursor(0)
    
    task.wait(0.1)
    isRunning = false
end

