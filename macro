        writefile(SAVE_FILE, HttpService:JSONEncode(data))
    end)
end

-- ==========================================
-- ASSIST (starts OFF)
--
-- How the numbers work (this is what the UI sliders edit):
--   Smoothing  ("Strength")  how tightly the aim point follows the target each frame.
--                            1.0 = locked on instantly, lower = the point trails behind.
--                            It is frame-rate independent (tuned at 60 FPS).
--   Prediction               base lead time in seconds: aims at where the target will be
--                            after this long, using its measured velocity.
--   ProjectileSpeed          studs/sec. When > 0, adds distance / speed to the lead so far
--                            targets get led more than near ones. 0 = instant (off).
--   PingComp                 adds your live round-trip ping to the lead time.
-- ==========================================
local AssistSettings = {
    Enabled = false,
    TargetPlayer = "Auto (Closest)",
    Effectiveness = 400,
    Mode = "Classic",
    -- LIVE values read every frame. Classic/Aggressive/Smart overwrite them with fixed
    -- numbers when selected; Custom copies them from the Custom* values below, which the
    -- sliders edit directly, so dragging a slider changes real behavior immediately.
    Smoothing = 0.6,
    Prediction = 0.12,
    ProjectileSpeed = 0,
    PingComp = false,
    CustomSmoothing = 0.6,        -- starts equal to Classic
    CustomPrediction = 0.12,      -- starts equal to Classic
    CustomProjectileSpeed = 0,    -- 0 = off, so Custom starts out behaving like Classic
    SmartProjectileSpeed = 200,   -- best guess; tune it in the Assist tab if shots lead too much/little
    RadiusPresets = { 150, 250, 400, 600, 9999 },
}

local function applyAimMode(name)
    local s = AssistSettings
    s.Mode = name
    if name == "Classic" then
        s.Smoothing, s.Prediction, s.ProjectileSpeed, s.PingComp = 0.6, 0.12, 0, false
    elseif name == "Aggressive" then
        s.Smoothing, s.Prediction, s.ProjectileSpeed, s.PingComp = 0.95, 0.3, 0, false
    elseif name == "Smart" then
        s.Smoothing, s.Prediction, s.ProjectileSpeed, s.PingComp = 1.0, 0.08, s.SmartProjectileSpeed, true
    else -- Custom
        s.Smoothing, s.Prediction, s.ProjectileSpeed, s.PingComp =
            s.CustomSmoothing, s.CustomPrediction, s.CustomProjectileSpeed, false
    end
end

local currentBestTarget = nil -- Vector2 screen point the Snowball macro clicks on (nil = no target)
local lockedPlayer = nil
local tracks = {}             -- [player] = { root, pos, vel, t }
local pingRtt = 0.08          -- smoothed round-trip ping in seconds

local STICKY_RATIO = 1.35     -- keep the current target unless another is >35% closer to the crosshair
local VEL_TAU = 0.08          -- velocity filter time constant (seconds)
local MAX_TRACK_SPEED = 260   -- studs/s; anything faster is a teleport, not movement
local MAX_LEAD = 0.8          -- never lead more than this many seconds

task.spawn(function()
    while Alive.v do
        local rtt
        local ok, ms = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        if ok and type(ms) == "number" and ms > 0 then
            rtt = ms / 1000
        else
            local ok2, one = pcall(function() return p:GetNetworkPing() end)
            if ok2 and type(one) == "number" then rtt = one * 2 end
        end
        if rtt then
            pingRtt = pingRtt + (math.clamp(rtt, 0, 0.6) - pingRtt) * 0.4
        end
        task.wait(0.75)
    end
end)

local function stepAssist(dt)
    local s = AssistSettings
    if not s.Enabled then
        currentBestTarget, lockedPlayer = nil, nil
        if next(tracks) ~= nil then tracks = {} end -- no stale velocities when it's switched back on
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then
        currentBestTarget = nil
        return
    end

    local now = clock()
    local vs = cam.ViewportSize
    local center = Vector2.new(vs.X / 2, vs.Y / 2)
    local myRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    local origin = myRoot and myRoot.Position or cam.CFrame.Position
    local auto = (s.TargetPlayer == "Auto (Closest)")

    local bestPlr, bestScreen, bestD
    local lockScreen, lockD

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= p then
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local pos = root.Position

                -- Velocity is measured for every valid player every frame (so it's already
                -- warm when you pick them), smoothed with a time-constant filter so network
                -- replication jitter doesn't throw the lead around.
                local tr = tracks[plr]
                if not tr or tr.root ~= root then -- first sight, or they respawned
                    tr = { root = root, pos = pos, vel = Vector3.new(0, 0, 0), t = now }
                    tracks[plr] = tr
                else
                    local sdt = now - tr.t
                    if sdt > 0 then
                        if sdt > 0.3 then
                            tr.vel = Vector3.new(0, 0, 0)
                        else
                            local raw = (pos - tr.pos) / sdt
                            if raw.Magnitude > MAX_TRACK_SPEED then
                                tr.vel = Vector3.new(0, 0, 0)
                            else
                                tr.vel = tr.vel:Lerp(raw, 1 - math.exp(-sdt / VEL_TAU))
                            end
                        end
                        tr.pos, tr.t = pos, now
                    end
                end

                if auto or plr.Name == s.TargetPlayer then
                    local lead = s.Prediction
                    if s.ProjectileSpeed > 0 then
                        lead = lead + (pos - origin).Magnitude / s.ProjectileSpeed
                    end
                    if s.PingComp then lead = lead + pingRtt end
                    lead = math.clamp(lead, 0, MAX_LEAD)

                    local sp, onScreen = cam:WorldToViewportPoint(pos + tr.vel * lead)
                    if onScreen then
                        local v = Vector2.new(sp.X, sp.Y)
                        local d = (v - center).Magnitude
                        if d < s.Effectiveness then
                            if not bestD or d < bestD then
                                bestPlr, bestScreen, bestD = plr, v, d
                            end
                            if plr == lockedPlayer then
                                lockScreen, lockD = v, d
                            end
                        end
                    end
                end
            end
        end
    end

    -- Sticky targeting: don't flip between two similar targets frame to frame.
    local pick, pickScreen = bestPlr, bestScreen
    if lockScreen and bestD and lockD <= bestD * STICKY_RATIO + 12 then
        pick, pickScreen = lockedPlayer, lockScreen
    end

    if not pick then
        currentBestTarget, lockedPlayer = nil, nil
    elseif pick ~= lockedPlayer or not currentBestTarget then
        lockedPlayer, currentBestTarget = pick, pickScreen -- new target: snap, don't glide across the screen
    else
        -- Frame-rate independent smoothing; identical to the old behavior at 60 FPS.
        local alpha = 1 - (1 - s.Smoothing) ^ (math.clamp(dt, 0.001, 0.1) * 60)
        currentBestTarget = currentBestTarget:Lerp(pickScreen, alpha)
    end
end

keep(RunService.RenderStepped:Connect(stepAssist))

keep(Players.PlayerRemoving:Connect(function(plr)
    tracks[plr] = nil
    if lockedPlayer == plr then
        lockedPlayer, currentBestTarget = nil, nil
    end
    if AssistSettings.TargetPlayer == plr.Name then
        AssistSettings.TargetPlayer = "Auto (Closest)"
        safeUI("targetChanged")
    end
end))

-- ==========================================
-- TIMESTAMP MACRO ENGINE
-- Every event has an absolute time (ms) from trigger. Each Heartbeat fires
-- all events that are due, so delays never accumulate and several events
-- can land in one frame. A down and its matching up never share a frame,
-- except 0ms taps, which fire together like the hardware macro does.
-- ==========================================
local Engine = { run = nil, conn = nil }

local function sendEvent(e, run)
    pcall(function()
        if e.kind == "key" then
            VIM:SendKeyEvent(e.down, e.code, false, game)
        else
            if e.down then
                local x, y
                if e.aim and AssistSettings.Enabled and currentBestTarget then
                    x, y = currentBestTarget.X, currentBestTarget.Y
                else
                    local l = UIS:GetMouseLocation()
                    x, y = l.X, l.Y
                end
                run.pos[e.id] = { x, y }
            end
            local pos = run.pos[e.id]
            VIM:SendMouseButtonEvent(pos[1], pos[2], e.code, e.down, game, 0)
        end
    end)
    run.held[e.id] = e.down and e or nil
end

local function releaseHeld(run)
    for id, e in pairs(run.held) do
        sendEvent({ kind = e.kind, code = e.code, down = false, id = id }, run)
    end
    run.held = {}
end

local function stopEngine()
    if Engine.conn then
        Engine.conn:Disconnect()
        Engine.conn = nil
    end
    local run = Engine.run
    Engine.run = nil
    if run then releaseHeld(run) end
end

local function stepEngine()
    local run = Engine.run
    if not run then return end

    local now = (clock() - run.t0) * 1000
    local downThisFrame = {}
    local events = run.events

    while run.i <= #events do
        local e = events[run.i]
        if e.t > now then break end
        if not e.down and not e.instant and downThisFrame[e.id] then break end -- push up to next frame (0ms taps excepted)
        sendEvent(e, run)
        if e.down then downThisFrame[e.id] = true end
        run.i = run.i + 1
    end

    if run.i > #events then
        stopEngine()
    end
end

local function startSequence(events)
    stopEngine() -- retrigger = clean restart, held inputs released first
    Engine.run = { events = events, i = 1, t0 = clock(), held = {}, pos = {} }
    Engine.conn = RunService.Heartbeat:Connect(stepEngine)
    stepEngine() -- fire first event immediately, zero added latency
end

-- Sequence builder: each step is down at cursor, up at cursor+hold,
-- next step at cursor+hold+gap (times in ms).
local function newSeq()
    local s = { events = {}, t = 0, n = 0 }
    local function add(kind, code, hold, gap, aim)
        s.n = s.n + 1
        table.insert(s.events, { t = s.t, kind = kind, code = code, down = true, id = s.n, aim = aim })
        table.insert(s.events, { t = s.t + hold, kind = kind, code = code, down = false, id = s.n, instant = (hold == 0) })
        s.t = s.t + hold + (gap or 0)
        return s
    end
    function s.key(code, hold, gap) return add("key", code, hold, gap) end
    function s.click(hold, gap, aim) return add("mouse", 0, hold, gap, aim) end
    function s.mouse(btn, hold, gap) return add("mouse", btn, hold, gap) end
    return s
end

