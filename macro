-- ==========================================
-- RE-RUN SAFETY
-- Every connection is registered here so running the script a second time cleanly
-- replaces the first copy instead of stacking duplicate hotkeys (double-firing macros).
-- ==========================================
local Conns = {}
local Alive = { v = true }
local function keep(conn)
    Conns[#Conns + 1] = conn
    return conn
end

do
    local prev = rawget(_G, "__ExoticaCleanup")
    if type(prev) == "function" then pcall(prev) end
end

-- Late-bound bridge to the UI. Everything the UI provides (toast, key-chip refresh, ...)
-- is optional, so the macros and hotkeys keep working even if the UI fails to build.
local UI = {}
local function safeUI(name, ...)
    local fn = UI[name]
    if fn then pcall(fn, ...) end
end

