            keyButtonRefs[listeningMacro].Text = tostring(k.Name)
            keyButtonRefs[listeningMacro].TextColor3 = Color3.fromRGB(0, 220, 255)
            listeningMacro = nil
            saveKeybinds() -- Saves keybind to memory file automatically
        else
            if k == Config.Snowball.Key then
                task.spawn(runSnowball)
            elseif k == Config.Board.Key then
                task.spawn(runBoard)
            elseif k == Config.RPG.Key then
                task.spawn(runRpg)
            elseif k == Config.Combo.Key then
                task.spawn(runCombo)
            end
        end
    end)

    local visible = true
    toggleBtn.Activated:Connect(function()
        visible = not visible
        f.Visible = visible
    end)
end)
