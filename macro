local AimSettings = {
    Enabled = true,
    Radius = 500,
    Smoothing = 0.35,
    PredictionFactor = 0.12,
    WallCheck = true,
    RadiusPresets = { 150, 300, 500, 800, 9999 }
}

local currentBestTarget = nil
local targetVelocities = {}

RunService.RenderStepped:Connect(function(dt)
    if not AimSettings.Enabled then
        currentBestTarget = nil
        return
    end

    local closestTarget = nil
    local shortestDist = AimSettings.Radius
    local viewportCenter = Camera.ViewportSize / 2
    local char = p.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= p and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local targetRoot = plr.Character.HumanoidRootPart
                local hasLOS = true
                if AimSettings.WallCheck and root then
                    local raycastParams = RaycastParams.new()
                    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                    raycastParams.FilterDescendantsInstances = {char, plr.Character}
                    local rayResult = workspace:Raycast(root.Position, targetRoot.Position - root.Position, raycastParams)
                    if rayResult then hasLOS = false end
                end

                if hasLOS then
                    local lastPos = targetVelocities[plr] and targetVelocities[plr].pos or targetRoot.Position
                    local currentPos = targetRoot.Position
                    local velocity = (currentPos - lastPos) / math.max(dt, 0.001)
                    targetVelocities[plr] = { pos = currentPos, vel = velocity }

                    local predictedPos = currentPos + (velocity * AimSettings.PredictionFactor)
                    local screenPos, onScreen = Camera:WorldToViewportPoint(predictedPos)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestTarget = Vector2.new(screenPos.X, screenPos.Y)
                        end
                    end
                end
            end
        end
    end

    if closestTarget then
        if currentBestTarget then
            currentBestTarget = currentBestTarget:Lerp(closestTarget, AimSettings.Smoothing)
        else
            currentBestTarget = closestTarget
        end
    else
        currentBestTarget = nil
    end
end)

local function clickCursor(b)
    pcall(function()
        local loc = UIS:GetMouseLocation()
        local btn = b or 0
        VIM:SendMouseButtonEvent(loc.X, loc.Y, btn, true, game, 0)
        task.wait(0.015)
        VIM:SendMouseButtonEvent(loc.X, loc.Y, btn, false, game, 0)
    end)
end

local function clickAtTarget(b)
    pcall(function()
        local mouseLoc = UIS:GetMouseLocation()
        local targetX = (AimSettings.Enabled and currentBestTarget) and currentBestTarget.X or mouseLoc.X
        local targetY = (AimSettings.Enabled and currentBestTarget) and currentBestTarget.Y or mouseLoc.Y
        local btn = b or 0

        VIM:SendMouseButtonEvent(targetX, targetY, btn, true, game, 0)
        task.wait(0.015)
        VIM:SendMouseButtonEvent(targetX, targetY, btn, false, game, 0)
    end)
end

local function pressKey(k)
    pcall(function()
        VIM:SendKeyEvent(true, k, false, game)
        task.wait(0.01)
        VIM:SendKeyEvent(false, k, false, game)
    end)
end

local function runSnowball()
    if isRunning then return end
    isRunning = true
    pressKey(Enum.KeyCode.Seven)
    clickAtTarget(0)
    task.wait(0.02)
    pressKey(Enum.KeyCode.Nine)
    clickAtTarget(0)
    task.wait(0.02)
    pressKey(Enum.KeyCode.Six)
    clickAtTarget(0)
    task.wait(0.1)
    isRunning = false
end

