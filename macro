        fovBtn.Text = AssistSettings.Effectiveness > 5000 and "Unlimited" or (AssistSettings.Effectiveness .. "px")
    end)

    -- Slot info row — opens a panel listing what goes in each slot, grouped by
    -- why it matters: weapons the macros fire, vs. the extra gear the Board
    -- Combo swings through. Each group gets its own accent color (cyan / violet)
    -- so a glance at the slot number alone tells you which group it belongs to.
    local _, infoBtn = makeRow("ℹ️ Slots", "View")
    local INFO_WIDTH = 260

    local infoFrame = Instance.new("Frame", sg)
    infoFrame.Size = UDim2.new(0, INFO_WIDTH, 0, 10) -- height set once content is built
    infoFrame.Position = UDim2.new(0.02, 325, 0.28, 0)
    infoFrame.BackgroundColor3 = COLORS.panel
    infoFrame.BackgroundTransparency = 0.08
    infoFrame.BorderSizePixel = 0
    infoFrame.Visible = false
    infoFrame.Active = true
    infoFrame.ClipsDescendants = false
    corner(infoFrame, 16)
    local infoStroke = Instance.new("UIStroke", infoFrame)
    infoStroke.Color = Color3.fromRGB(0, 200, 255)
    infoStroke.Transparency = 0.4
    infoStroke.Thickness = 2

    local infoTitle = Instance.new("TextButton", infoFrame)
    infoTitle.Size = UDim2.new(1, 0, 0, 30)
    infoTitle.BackgroundTransparency = 1
    infoTitle.Font = Enum.Font.GothamBold
    infoTitle.Text = "SLOT SETUP"
    infoTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    infoTitle.TextSize = 13
    infoTitle.AutoButtonColor = false
    makeDraggable(infoTitle, infoFrame)

    local PAD = 14
    local y = 30

    for groupIndex, group in ipairs(SlotInfo) do
        local groupColor = (groupIndex == 1) and COLORS.accent or COLORS.accent2

        if groupIndex > 1 then
            y = y + 6
            local divider = Instance.new("Frame", infoFrame)
            divider.Size = UDim2.new(1, -PAD * 2, 0, 1)
            divider.Position = UDim2.new(0, PAD, 0, y)
            divider.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
            divider.BorderSizePixel = 0
            y = y + 7
        end

        local heading = Instance.new("TextLabel", infoFrame)
        heading.Size = UDim2.new(1, -PAD * 2, 0, 18)
        heading.Position = UDim2.new(0, PAD, 0, y)
        heading.BackgroundTransparency = 1
        heading.Font = Enum.Font.GothamBold
        heading.TextXAlignment = Enum.TextXAlignment.Left
        heading.TextColor3 = groupColor
        heading.TextSize = 12
        heading.Text = group.heading
        y = y + 18

        local subtitle = Instance.new("TextLabel", infoFrame)
        subtitle.Size = UDim2.new(1, -PAD * 2, 0, 14)
        subtitle.Position = UDim2.new(0, PAD, 0, y)
        subtitle.BackgroundTransparency = 1
        subtitle.Font = Enum.Font.GothamMedium
        subtitle.TextXAlignment = Enum.TextXAlignment.Left
        subtitle.TextColor3 = Color3.fromRGB(140, 140, 170)
        subtitle.TextSize = 10
        subtitle.Text = group.subtitle
        y = y + 18

        for _, entry in ipairs(group.rows) do
            local row = Instance.new("TextLabel", infoFrame)
            row.Size = UDim2.new(1, -PAD * 2, 0, 20)
            row.Position = UDim2.new(0, PAD, 0, y)
            row.BackgroundTransparency = 1
            row.Font = Enum.Font.Gotham
            row.TextSize = 11
            row.TextXAlignment = Enum.TextXAlignment.Left
            row.TextColor3 = Color3.fromRGB(220, 220, 230)
            row.RichText = true
            row.TextWrapped = true
            row.Text = string.format(
                '<font color="%s"><b>%s</b></font>   %s',
                colorHex(groupColor), entry.slot, escapeRich(entry.item)
            )
            y = y + 20
        end

        y = y + 4
    end

    infoFrame.Size = UDim2.new(0, INFO_WIDTH, 0, y + PAD)

    infoBtn.Activated:Connect(function()
        infoFrame.Visible = not infoFrame.Visible
    end)

    -- First-trigger slot warning: a toast that appears once, the first time any
    -- macro fires, reminding the player to check their slots. Tapping it opens
    -- Slot Setup; otherwise it fades out on its own.
    -- Swap in your own uploaded sound's asset id here if this one doesn't play —
    -- it's a commonly cited built-in id, not one I could confirm still works.
    local WarningSoundId = "rbxasset://sounds/electronicpingshort.wav"

    local function showSlotWarning()
        local toast = Instance.new("TextButton", sg)
        toast.Size = UDim2.new(0, 280, 0, 74)
        toast.Position = UDim2.new(0.5, -140, 0.06, 0)
        toast.BackgroundColor3 = COLORS.panel
        toast.BackgroundTransparency = 1
        toast.AutoButtonColor = false
        toast.Text = ""
        toast.ZIndex = 50
        corner(toast, 14)
        local toastStroke = Instance.new("UIStroke", toast)
        toastStroke.Color = COLORS.warn
        toastStroke.Transparency = 1
        toastStroke.Thickness = 2

        local toastTitle = Instance.new("TextLabel", toast)
        toastTitle.Size = UDim2.new(1, -20, 0, 20)
        toastTitle.Position = UDim2.new(0, 10, 0, 8)
        toastTitle.BackgroundTransparency = 1
        toastTitle.Font = Enum.Font.GothamBold
        toastTitle.TextXAlignment = Enum.TextXAlignment.Left
        toastTitle.TextColor3 = COLORS.warn
        toastTitle.TextSize = 13
        toastTitle.TextTransparency = 1
        toastTitle.Text = "⚠️ Check Your Slots"

        local toastBody = Instance.new("TextLabel", toast)
        toastBody.Size = UDim2.new(1, -20, 0, 32)
        toastBody.Position = UDim2.new(0, 10, 0, 28)
        toastBody.BackgroundTransparency = 1
        toastBody.Font = Enum.Font.Gotham
        toastBody.TextXAlignment = Enum.TextXAlignment.Left
        toastBody.TextYAlignment = Enum.TextYAlignment.Top
        toastBody.TextWrapped = true
        toastBody.TextColor3 = Color3.fromRGB(220, 220, 230)
        toastBody.TextSize = 11
        toastBody.TextTransparency = 1
        toastBody.Text = "Put every weapon in the slot shown, or the macro won't work right."

        local toastHint = Instance.new("TextLabel", toast)
        toastHint.Size = UDim2.new(1, -20, 0, 12)
        toastHint.Position = UDim2.new(0, 10, 1, -18)
        toastHint.BackgroundTransparency = 1
        toastHint.Font = Enum.Font.GothamMedium
        toastHint.TextXAlignment = Enum.TextXAlignment.Left
        toastHint.TextColor3 = Color3.fromRGB(140, 140, 170)
        toastHint.TextSize = 9
        toastHint.TextTransparency = 1
        toastHint.Text = "Tap for Slot Setup"

        pcall(function()
            local sound = Instance.new("Sound", toast)
            sound.SoundId = WarningSoundId
            sound.Volume = 0.5
            sound:Play()
        end)

        local fadeIn = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local fadeOut = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        local labels = { toastTitle, toastBody, toastHint }

        TweenService:Create(toast, fadeIn, { BackgroundTransparency = 0.03 }):Play()
        TweenService:Create(toastStroke, fadeIn, { Transparency = 0.1 }):Play()
        for _, lbl in ipairs(labels) do
            TweenService:Create(lbl, fadeIn, { TextTransparency = 0 }):Play()
        end

        local dismissed = false
        local function dismiss()
            if dismissed then return end
            dismissed = true
            TweenService:Create(toast, fadeOut, { BackgroundTransparency = 1 }):Play()
            TweenService:Create(toastStroke, fadeOut, { Transparency = 1 }):Play()
            for _, lbl in ipairs(labels) do
                TweenService:Create(lbl, fadeOut, { TextTransparency = 1 }):Play()
            end
            task.delay(fadeOut.Time, function() toast:Destroy() end)
        end

        toast.Activated:Connect(function()
            infoFrame.Visible = true
            dismiss()
        end)

        task.delay(5, dismiss)
    end

    triggerMacro = function(name)
        if not hasShownSlotWarning then
            hasShownSlotWarning = true
            showSlotWarning()
        end
        Macros[name]()
    end

    -- Show / hide
    toggleBtn.Activated:Connect(function()
        if toggleState.moved then return end
        f.Visible = not f.Visible
        infoFrame.Visible = false
    end)

    -- Input handling
    UIS.InputBegan:Connect(function(input, gpe)
        local k = input.KeyCode
        if k == KC.Unknown then return end
        if gpe and input.UserInputType == Enum.UserInputType.Keyboard then return end

        if listeningMacro then
            Config[listeningMacro].Key = k
            keyButtons[listeningMacro].Text = k.Name
            keyButtons[listeningMacro].TextColor3 = COLORS.accent
            listeningMacro = nil
            saveKeybinds()
            return
        end

        for name, info in pairs(Config) do
            -- Thumbstick1 is an axis and never fires InputBegan; a stick click is ButtonL3
            if k == info.Key or (info.Key == KC.Thumbstick1 and k == KC.ButtonL3) then
                triggerMacro(name)
                break
            end
        end
    end)
end)

print("Exotica: Master Suite Initialized Successfully!")
