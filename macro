        keyButtonRefs[listeningMacro].TextColor3 = Color3.fromRGB(0, 220, 255)
        listeningMacro = nil
    else
        if k == Config.Snowball.Key then task.spawn(runSnowball)
        elseif k == Config.Combo.Key then task.spawn(runCombo)
        elseif k == Config.RPG.Key then task.spawn(runRpg)
