            end
            writefile(SAVE_FILE, HttpService:JSONEncode(data))
        end)
    end
end

-- High-Performance Assist Settings (Starts OFF by default)
local AssistSettings = {
    Enabled = false,
    TargetPlayer = "Auto (Closest)",
    Effectiveness = 400,
    Smoothing = 0.6,
    Prediction = 0.12,
    RadiusPresets = { 150, 250, 400, 600, 9999 }
}

local currentBestTarget = nil
local targetVelocities = {}

-- High-Performance Assist Loop
RunService.RenderStepped:Connect(function(dt)
    if not AssistSettings.Enabled then
        currentBestTarget = nil
        return
    end

    local closestTarget = nil
    local shortestDist = AssistSettings.Effectiveness
    local viewportCenter = Camera.ViewportSize / 2

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= p and (AssistSettings.TargetPlayer == "Auto (Closest)" or plr.Name == AssistSettings.TargetPlayer) then
            if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local rootPart = plr.Character.HumanoidRootPart
                    local lastPos = targetVelocities[plr] and targetVelocities[plr].pos or rootPart.Position
                    local currentPos = rootPart.Position
                    local velocity = (currentPos - lastPos) / math.max(dt, 0.001)
                    targetVelocities[plr] = { pos = currentPos, vel = velocity }

                    local predictedPos = currentPos + (velocity * AssistSettings.Prediction)
                    local screenPos, onScreen = Camera:WorldToViewportPoint(predictedPos)
                    
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestTarget = Vector2.new(screenPos.X, screenPos.Y)
                        end
                    end
                end
            end
        end
    end

    if closestTarget then
        if currentBestTarget then
            currentBestTarget = currentBestTarget:Lerp(closestTarget, AssistSettings.Smoothing)
        else
            currentBestTarget = closestTarget
        end
    else
        currentBestTarget = nil
    end
end)

local function clickCursor(b)
    pcall(function()
        local loc = UIS:GetMouseLocation()
        local btn = b or 0
        VIM:SendMouseButtonEvent(loc.X, loc.Y, btn, true, game, 0)
        task.wait(0.01)
        VIM:SendMouseButtonEvent(loc.X, loc.Y, btn, false, game, 0)
    end)
end

local function clickAtTarget(b)
    pcall(function()
        local mouseLoc = UIS:GetMouseLocation()
        local targetX = (AssistSettings.Enabled and currentBestTarget) and currentBestTarget.X or mouseLoc.X
        local targetY = (AssistSettings.Enabled and currentBestTarget) and currentBestTarget.Y or mouseLoc.Y
        local btn = b or 0

        VIM:SendMouseButtonEvent(targetX, targetY, btn, true, game, 0)
        task.wait(0.01)
        VIM:SendMouseButtonEvent(targetX, targetY, btn, false, game, 0)
    end)
end

local function pressKey(k)
    pcall(function()
        VIM:SendKeyEvent(true, k, false, game)
        task.wait(0.01)
        VIM:SendKeyEvent(false, k, false, game)
    end)
end

-- Thread management flags to prevent spam glitches & weapon locking
local runningMacroThread = nil

local function executeSafeMacro(macroFunc)
    if runningMacroThread then
        task.cancel(runningMacroThread)
        runningMacroThread = nil
    end
    runningMacroThread = task.spawn(function()
        macroFunc()
        runningMacroThread = nil
    end)
end

local function runSnowball()
    pressKey(Enum.KeyCode.Seven)
    clickAtTarget(0)
    task.wait(0.02)
    pressKey(Enum.KeyCode.Nine)
    clickAtTarget(0)
    task.wait(0.02)
    pressKey(Enum.KeyCode.Six)
    clickAtTarget(0)
end

