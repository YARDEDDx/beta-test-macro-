local function runCombo()
    local spamming = true
    task.spawn(function()
        while spamming do
            pcall(function()
                local loc = UIS:GetMouseLocation()
                VIM:SendMouseButtonEvent(loc.X, loc.Y, 0, true, game, 0)
                task.wait(0.02)
                VIM:SendMouseButtonEvent(loc.X, loc.Y, 0, false, game, 0)
            end)
            task.wait(0.04)
        end
    end)

    pressKey(Enum.KeyCode.One)
    task.wait(0.15)
    pressKey(Enum.KeyCode.Two)
    task.wait(0.15)
    pressKey(Enum.KeyCode.Zero)
    task.wait(0.15)
    pressKey(Enum.KeyCode.Seven)
    task.wait(0.15)
    pressKey(Enum.KeyCode.Four)
    pcall(function()
        local l = UIS:GetMouseLocation()
        VIM:SendMouseButtonEvent(l.X, l.Y, 0, true, game, 0)
        task.wait(0.715)
        VIM:SendMouseButtonEvent(l.X, l.Y, 0, false, game, 0)
    end)
    task.wait(0.15)
    pressKey(Enum.KeyCode.Nine)
    task.wait(0.15)
    pressKey(Enum.KeyCode.Two)
    task.wait(0.15)
    pressKey(Enum.KeyCode.Zero)
    task.wait(0.15)
    pressKey(Enum.KeyCode.Eight)
    task.wait(1.0)

    spamming = false
    task.wait(0.05)
    pressKey(Enum.KeyCode.Three)
end

