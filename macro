-- Synapse's slot 4 step is a "Double Click": two quick left clicks. The XML doesn't record
-- how fast Razer's double click is, so each of the two clicks is held this many ms.
-- If the slot 4 weapon still doesn't hit, try raising it (10, 15, 20).
local DoubleClickMs = 8

-- Board combo: built event-for-event from the Razer Synapse XML (114ms + the double click).
-- Args are hold (ms between down and up) then gap (ms of delay after the up).
-- A hold of 0 is an instant tap, exactly as the XML has it.
local BoardSeq = newSeq()
    .key(KC.One, 0)
    .click(12)
    .click(12)
    .key(KC.Four, 0)
    .click(DoubleClickMs)     -- Double Click: first click
    .click(DoubleClickMs, 20) -- Double Click: second click, then the XML's 20ms delay
    .key(KC.Eight, 0)
    .click(20)
    .click(20)
    .click(10)
    .key(KC.Zero, 0)
    .click(10, 10)
    .key(KC.Six, 0)
    .click(0)
    .events

local SnowballSeq = newSeq()
    .key(KC.Seven, 10)
    .click(10, 20, true)
    .key(KC.Nine, 10)
    .click(10, 20, true)
    .key(KC.Six, 10)
    .click(10, 0, true)
    .events

local RpgSeq = newSeq()
    .key(KC.Five, 10, 100)
    .click(10, 20)
    .key(KC.R, 10)
    .key(KC.Six, 10)
    .click(10)
    .events

local Macros = {
    Snowball = function() startSequence(SnowballSeq) end,
    Board    = function() startSequence(BoardSeq) end,
    RPG      = function() startSequence(RpgSeq) end,
}

-- ==========================================
-- TRIGGERS + HOTKEYS
-- Registered here (not inside the UI builder) so hotkeys work no matter what.
-- ==========================================
local listeningMacro = nil
local hasShownSlotWarning = false -- only the very first macro trigger (any of the 3) shows the warning

local function triggerMacro(name)
    if not hasShownSlotWarning then
        hasShownSlotWarning = true
        safeUI("slotWarning")
    end
    local fn = Macros[name]
    if fn then fn() end
    safeUI("flash", name)
end

keep(UIS.InputBegan:Connect(function(input, gpe)
    local k = input.KeyCode
    if k == KC.Unknown then return end
    if gpe and input.UserInputType == Enum.UserInputType.Keyboard then return end

    if listeningMacro then
        local name = listeningMacro
        listeningMacro = nil
        Config[name].Key = k
        saveKeybinds()
        safeUI("keyBound", name)
        return
    end

    for name, info in pairs(Config) do
        -- Thumbstick1 is an axis and never fires InputBegan; a stick click is ButtonL3
        if k == info.Key or (info.Key == KC.Thumbstick1 and k == KC.ButtonL3) then
            triggerMacro(name)
            break
        end
    end
end))
