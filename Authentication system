local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- ==========================================
-- KEYAUTH CREDENTIALS
-- ==========================================
local name = "Exotica Macros"
local ownerid = "kFHLyWbpTo"
local version = "1.0"

-- Global Session Variable
local sessionid = nil

-- 1. Perform KeyAuth Initialization
local function initKeyAuth()
    local hwid = player.UserId .. "_" .. tostring(game.JobId ~= "" and game.JobId or "Studio")
    local initUrl = string.format("https://keyauth.win/api/1.2/?type=init&name=%s&ownerid=%s&ver=%s", name, ownerid, version)
    
    local success, response = pcall(function()
        return request({
            Url = initUrl,
            Method = "GET"
        })
    end)

    if success and response and response.StatusCode == 200 then
        local data = HttpService:JSONDecode(response.Body)
        if data.success then
            sessionid = data.sessionid
            return true
        end
    end
    return false
end

-- 2. Create Login UI for Delta
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ExoticaKeyLoader"
screenGui.ResetOnSpawn = false
screenGui.Parent = (gethui and gethui()) or CoreGui

local frame = Instance.new("Frame", screenGui)
frame.Size = UDim2.new(0, 320, 0, 160)
frame.Position = UDim2.new(0.5, -160, 0.5, -80)
frame.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
frame.BorderSizePixel = 0

local uiCorner = Instance.new("UICorner", frame)
uiCorner.CornerRadius = UDim.new(0, 8)

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBold
title.Text = "Exotica Macros - Login"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 16

local textBox = Instance.new("TextBox", frame)
textBox.Size = UDim2.new(0.85, 0, 0, 40)
textBox.Position = UDim2.new(0.075, 0, 0.35, 0)
textBox.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
textBox.PlaceholderText = "Enter License Key..."
textBox.Text = ""
textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
textBox.Font = Enum.Font.Gotham
textBox.TextSize = 14

local boxCorner = Instance.new("UICorner", textBox)
boxCorner.CornerRadius = UDim.new(0, 6)

local submitBtn = Instance.new("TextButton", frame)
submitBtn.Size = UDim2.new(0.85, 0, 0, 40)
submitBtn.Position = UDim2.new(0.075, 0, 0.65, 0)
submitBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 100)
submitBtn.Font = Enum.Font.GothamBold
submitBtn.Text = "Verify Key"
submitBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
submitBtn.TextSize = 14

local btnCorner = Instance.new("UICorner", submitBtn)
btnCorner.CornerRadius = UDim.new(0, 6)

-- Run Init in Background
task.spawn(function()
    initKeyAuth()
end)

-- 3. Handle Verification Logic & HWID Locking
submitBtn.Activated:Connect(function()
    local enteredKey = textBox.Text
    if enteredKey == "" then
        textBox.PlaceholderText = "Please enter a key!"
        return
    end

    submitBtn.Text = "Verifying..."
    
    if not sessionid then
        local initialized = initKeyAuth()
        if not initialized then
            submitBtn.Text = "Verify Key"
            textBox.Text = ""
            textBox.PlaceholderText = "Session init failed! Retry."
            return
        end
    end

    local hwid = player.UserId .. "_" .. tostring(game.JobId ~= "" and game.JobId or "Studio")
    local url = string.format("https://keyauth.win/api/1.2/?type=license&key=%s&hwid=%s&sessionid=%s&name=%s&ownerid=%s", enteredKey, hwid, sessionid, name, ownerid)
    
    local success, response = pcall(function()
        return request({
            Url = url,
            Method = "GET"
        })
    end)

    if success and response and response.StatusCode == 200 then
        local data = HttpService:JSONDecode(response.Body)
        if data.success then
            submitBtn.Text = "Success! Loading..."
            task.wait(1)
            screenGui:Destroy()
            
            local mainScriptUrl = "https://raw.githubusercontent.com/YARDEDDx/beta-test-macro-/refs/heads/main/macro?nocache=" .. tostring(tick())
            local fetchSuccess, result = pcall(function()
                return game:HttpGet(mainScriptUrl)
            end)

            if not fetchSuccess or not result or result == "" then
                warn("Failed to fetch master script from GitHub!")
                return
            end

            local fn, err = loadstring(result)
            if not fn then
                warn("Compile Error: " .. tostring(err))
                return
            end

            print("Executing Master Suite...")
            fn()
        else
            submitBtn.Text = "Verify Key"
            textBox.Text = ""
            textBox.PlaceholderText = data.message or "Invalid or expired key!"
        end
    else
        submitBtn.Text = "Verify Key"
        textBox.Text = ""
        textBox.PlaceholderText = "Connection error to KeyAuth!"
    end
end)
