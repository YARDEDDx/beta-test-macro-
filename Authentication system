local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local name = "Exotica Macros"
local ownerid = "kFHLyWbpTo"
local version = "1.0"
local saveFileName = "ExoticaKey.txt"
local sessionid = nil

print("--- LOADER STARTED ---")

-- Safe Request Helper with detailed debugging
local function safeRequest(requestData)
    local reqFunc = request or (syn and syn.request) or (http and http.request)
    if not reqFunc then
        warn("[DEBUG] No global HTTP request function found in this executor!")
        return nil
    end
    
    local success, res = pcall(function()
        return reqFunc(requestData)
    end)
    
    if not success then
        warn("[DEBUG] HTTP Request execution failed: " .. tostring(res))
        return nil
    end
    return res
end

local function initKeyAuth()
    print("[DEBUG] Initializing KeyAuth session...")
    local initUrl = string.format("https://keyauth.win/api/1.2/?type=init&name=%s&ownerid=%s&ver=%s", name, ownerid, version)
    
    local response = safeRequest({
        Url = initUrl,
        Method = "GET"
    })

    if response and response.StatusCode == 200 then
        local successDec, data = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if successDec and data and data.success then
            sessionid = data.sessionid
            print("[DEBUG] Session initialized successfully:", sessionid)
            return true
        else
            warn("[DEBUG] Init JSON decode failed or returned false:", response.Body)
        end
    else
        warn("[DEBUG] Init HTTP request failed or bad status code.")
    end
    return false
end

local function executeMasterScript()
    print("[DEBUG] Fetching master script...")
    local mainScriptUrl = "https://raw.githubusercontent.com/YARDEDDx/beta-test-macro-/refs/heads/main/macro?nocache=" .. tostring(tick())
    
    local fetchSuccess, result = pcall(function()
        return game:HttpGet(mainScriptUrl)
    end)

    if not fetchSuccess or not result or result == "" then
        warn("[DEBUG] Failed to fetch master script from GitHub!")
        return
    end

    local fn, err = loadstring(result)
    if not fn then
        warn("[DEBUG] Compile Error: " .. tostring(err))
        return
    end

    print("[DEBUG] Executing Master Suite...")
    pcall(fn)
end

local function validateKey(keyToTest)
    if not sessionid then
        local inited = initKeyAuth()
        if not inited then return false, "Init Failed" end
    end

    local hwid = player.UserId .. "_" .. tostring(game.JobId ~= "" and game.JobId or "Studio")
    local url = string.format("https://keyauth.win/api/1.2/?type=license&key=%s&hwid=%s&sessionid=%s&name=%s&ownerid=%s", keyToTest, hwid, sessionid, name, ownerid)

    local response = safeRequest({
        Url = url,
        Method = "GET"
    })

    if response and response.StatusCode == 200 then
        local successDec, data = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if successDec and data then
            if data.success then
                if writefile then
                    pcall(function() writefile(saveFileName, keyToTest) end)
                end
                return true, "Success"
            else
                if isfile and isfile(saveFileName) and delfile then
                    pcall(function() delfile(saveFileName) end)
                end
                return false, data.message or "Invalid Key"
            end
        end
    end
    return false, "Connection Error"
end

-- Auto-login check
